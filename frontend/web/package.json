{
  "name": "aeios-weather-station",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test src/components/overview/model.test.ts src/motion/changes.test.ts && vitest run src/lib src/sim",
    "test:unit": "node --test src/components/overview/model.test.ts src/motion/changes.test.ts",
    "test:sim": "vitest run src/lib src/sim",
    "typecheck": "tsc -b",
    "lint": "eslint src/motion src/motion-lab src/design/motion.ts src/components/WeatherScene.tsx tests/e2e",
    "lint:all": "eslint .",
    "format:check": "prettier --check src/motion src/motion-lab src/design/motion.ts src/components/WeatherScene.tsx tests/e2e",
    "lint:css": "stylelint \"src/motion-lab/**/*.css\" \"src/design/motion*.css\" --allow-empty-input",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "^2.45.0",
    "@vitejs/plugin-react": "^4.3.4",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "motion": "^14.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.15.0",
    "three": "^0.171.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.16",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.171.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  }
}
