# Copy to ~/.config/aeios/uploader.env (mode 600). Never commit the real file.
AEIOS_INGEST_URL=https://<your-project-ref>.supabase.co/functions/v1/ingest
AEIOS_DEVICE_TOKEN=<64-hex-character token; only its SHA-256 goes in the cloud, see backend/supabase/seed.example.sql>
AEIOS_DEVICE_ID=node-gateway
